IMAGE_TAG=latest
APP_ENV=production
TZ=Asia/Yekaterinburg
HTTP_PORT=8080

POSTGRES_DB=taxi
POSTGRES_USER=taxi
POSTGRES_PASSWORD=change_me_strong_postgres_password

REDIS_PASSWORD=change_me_strong_redis_password

JWT_SECRET=change_me_access_secret_32_bytes_minimum
JWT_REFRESH_SECRET=change_me_refresh_secret_32_bytes_minimum

CORS_ALLOWED_ORIGINS=https://taxi.example.com
LOGGER_LEVEL=info
RATE_LIMIT_PER_MINUTE=120

DISPATCH_INITIAL_RADIUS_METERS=10000
DISPATCH_MAX_RADIUS_METERS=100000
DISPATCH_RADIUS_STEP_METERS=1000
DISPATCH_MAX_DRIVERS_PER_OFFER=5
DISPATCH_DRIVER_LOCATION_MAX_AGE=90s
DISPATCH_OFFER_TTL=45s
DISPATCH_ACCEPT_LOCK_TTL=90s
DISPATCH_WORKER_POLL_TIMEOUT=10s
DISPATCH_RECOVERY_INTERVAL=30s

# Immutable image digest, for example ghcr.io/project-osrm/osrm-backend@sha256:...
OSRM_IMAGE=
OSRM_URL=http://osrm:5000
OSRM_TIMEOUT=3s

# Shared mapping release (set through the generated deployment override)
TAXI_MAPS_PUBLIC_URL=
TAXI_MAPS_DATA_VERSION=
TAXI_MAPS_UPDATED_AT=
TAXI_ROUTING_DATA_VERSION=
TAXI_ROUTING_MAX_SNAP_METERS=500
TAXI_ROUTING_CACHE_TTL=5m
MAP_DATA_ROOT=/srv/taxi-maps
MAP_NETWORK=taxi-maps
MAP_ORIGIN_IMAGE=
MAP_CORS_ORIGIN=
