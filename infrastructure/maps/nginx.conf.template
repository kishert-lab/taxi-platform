proxy_cache_path /var/cache/nginx/maps levels=1:2 keys_zone=map_tiles:20m max_size=2g inactive=30d use_temp_path=off;
server {
    listen 8080;
    server_name _;
    gzip on;
    gzip_vary on;
    gzip_types application/json application/x-protobuf application/vnd.mapbox-vector-tile;
    add_header Access-Control-Allow-Origin "${MAP_CORS_ORIGIN}" always;
    add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
    add_header Access-Control-Allow-Headers "If-None-Match" always;
    add_header Access-Control-Expose-Headers "ETag, Cache-Control" always;
    add_header Vary "Origin" always;
    location /releases/ {
        if ($request_method = OPTIONS) { return 204; }
        limit_except GET HEAD { deny all; }
        proxy_pass http://map-origin:8000;
        proxy_cache map_tiles;
        proxy_cache_key "$uri";
        proxy_cache_valid 200 365d;
        proxy_cache_valid 204 1d;
        proxy_cache_lock on;
        proxy_cache_revalidate on;
        proxy_set_header Accept-Encoding "";
        proxy_read_timeout 20s;
        proxy_hide_header Set-Cookie;
    }
    location / { return 404; }
}
